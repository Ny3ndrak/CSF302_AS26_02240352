"""Compare binary and ternary search with a simple menu."""

import random

array = []


def binary_search(values, key):
    low, high = 0, len(values) - 1
    comparisons = 0

    while low <= high:
        middle = (low + high) // 2
        comparisons += 1
        if values[middle] == key:
            return middle, comparisons
        comparisons += 1
        if values[middle] < key:
            low = middle + 1
        else:
            high = middle - 1

    return -1, comparisons


def ternary_search(values, key):
    low, high = 0, len(values) - 1
    comparisons = 0

    while low <= high:
        first_middle = low + (high - low) // 3
        second_middle = high - (high - low) // 3

        comparisons += 1
        if values[first_middle] == key:
            return first_middle, comparisons
        comparisons += 1
        if values[second_middle] == key:
            return second_middle, comparisons

        comparisons += 1
        if key < values[first_middle]:
            high = first_middle - 1
        else:
            comparisons += 1
            if key > values[second_middle]:
                low = second_middle + 1
            else:
                low, high = first_middle + 1, second_middle - 1

    return -1, comparisons


def generate_array():
    global array
    size = int(input("Enter number of elements (n): "))
    low = int(input("Enter lower bound of random values: "))
    high = int(input("Enter upper bound of random values: "))
    array = sorted(random.randint(low, high) for _ in range(size))
    print("Array generated.\n")


def display_array():
    if not array:
        print("Array is empty. Generate it first (Option 1).\n")
    else:
        print("Array:", array, "\n")


def run_search(search, name):
    if not array:
        print("Array is empty. Generate it first (Option 1).\n")
        return

    key = int(input("Enter key to search: "))
    index, comparisons = search(array, key)
    if index == -1:
        print(f"{name}: not found. Comparisons: {comparisons}\n")
    else:
        print(f"{name}: found at index {index}. Comparisons: {comparisons}\n")


def best_case_analysis():
    if not array:
        print("Array is empty. Generate it first (Option 1).\n")
        return

    binary_key = array[(len(array) - 1) // 2]
    ternary_key = array[(len(array) - 1) // 3]
    _, binary_steps = binary_search(array, binary_key)
    _, ternary_steps = ternary_search(array, ternary_key)

    print("Best case (key found at the first position checked):")
    print(f"  Binary Search comparisons:  {binary_steps}")
    print(f"  Ternary Search comparisons: {ternary_steps}\n")


def worst_case_analysis():
    if not array:
        print("Array is empty. Generate it first (Option 1).\n")
        return

    missing_key = max(array) + 1000
    _, binary_steps = binary_search(array, missing_key)
    _, ternary_steps = ternary_search(array, missing_key)

    print("Worst case (key is not in the array):")
    print(f"  Binary Search comparisons:  {binary_steps}")
    print(f"  Ternary Search comparisons: {ternary_steps}\n")


def comparison_table():
    sizes = [10, 100, 1000, 10000, 100000, 1000000]
    print(f"{'n':>10} | {'Binary':>10} | {'Ternary':>10}")
    print("-" * 36)

    for size in sizes:
        values = sorted(random.randint(0, size * 10) for _ in range(size))
        missing_key = max(values) + 1000
        _, binary_steps = binary_search(values, missing_key)
        _, ternary_steps = ternary_search(values, missing_key)
        print(f"{size:>10} | {binary_steps:>10} | {ternary_steps:>10}")
    print()


def main():
    menu = """
========== MENU ==========
1. Generate n sorted random numbers
2. Display Array
3. Search using Binary Search
4. Search using Ternary Search
5. Best case step/frequency count
6. Worst case step/frequency count
7. Comparison table across increasing n
8. Exit
===========================
"""

    while True:
        print(menu)
        choice = input("Enter choice: ").strip()

        if choice == "1":
            generate_array()
        elif choice == "2":
            display_array()
        elif choice == "3":
            run_search(binary_search, "Binary search")
        elif choice == "4":
            run_search(ternary_search, "Ternary search")
        elif choice == "5":
            best_case_analysis()
        elif choice == "6":
            worst_case_analysis()
        elif choice == "7":
            comparison_table()
        elif choice == "8":
            print("Exiting.")
            break
        else:
            print("Invalid choice. Try again.\n")


if __name__ == "__main__":
    main()
